<Window x:Class="AutoKADN.Proyectos.FormatsResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoKADN" Width="640" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        Background="{StaticResource PageBackground}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="PathText" Style="{StaticResource Muted}" Margin="0,3,0,14" TextWrapping="Wrap"/>

        <Border Style="{StaticResource Card}">
            <ItemsControl x:Name="OutcomeList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontSize="15" FontWeight="Bold"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock x:Name="NoteText" Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abrir carpeta" Margin="0,0,8,0" Click="OnOpenFolder"/>
            <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" Click="OnClose"/>
        </StackPanel>
    </StackPanel>
</Window>
