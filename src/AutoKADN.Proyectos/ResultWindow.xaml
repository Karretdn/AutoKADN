<Window x:Class="AutoKADN.Proyectos.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoKADN" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource PageBackground}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="PathText" Style="{StaticResource Muted}" Margin="0,3,0,14" TextWrapping="Wrap"/>

        <Border Style="{StaticResource Card}">
            <ItemsControl x:Name="StepsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontSize="15" FontWeight="Bold"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Description}" FontSize="13.5"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock x:Name="NoteText" Style="{StaticResource Muted}" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenButton" Content="Abrir carpeta" Margin="0,0,8,0" Click="OnOpenFolder"/>
            <Button x:Name="PhotosButton" Content="Registro fotográfico…" Margin="0,0,8,0" Click="OnPhotos"/>
            <Button x:Name="CloseButton" Content="Cerrar" Margin="0,0,8,0" Click="OnClose"/>
            <Button x:Name="NewButton" Content="Nuevo proyecto" Style="{StaticResource PrimaryButton}" Click="OnNew"/>
        </StackPanel>
    </StackPanel>
</Window>
