<Window x:Class="AutoKADN.Proyectos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoKADN.Proyectos.ViewModels"
        xmlns:ctl="clr-namespace:AutoKADN.Proyectos.Controls"
        Title="AutoKADN · Nuevo proyecto" Width="680" Height="860" MinWidth="560" MinHeight="560"
        Background="{StaticResource PageBackground}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DateRow}">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource GroupHeader}"
                           Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="13.5"/>
                    <ctl:DateField Grid.Column="1" SelectedDate="{Binding Value, Mode=TwoWay}"
                                   IsManual="{Binding IsManual, Mode=TwoWay}" AutoHint="{Binding AutoHint}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra inferior -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding DestinationPath}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DestinationPath}"/>
                    <TextBlock Text="Esa carpeta ya existe: no se sobrescribe nada." Foreground="{StaticResource Danger}" FontSize="12"
                               Visibility="{Binding FolderExists, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Missing}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Missing}" TextWrapping="NoWrap"
                               Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Crear proyecto" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanCreate}" Click="OnCreateClick"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,10">

                <!-- Encabezado -->
                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nuevo proyecto" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Carpetas, soportes, fotos y plano a partir de la orden de trabajo" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Click="OnPhotosClick" Margin="0,0,8,0" ToolTip="Armar el registro fotográfico de un proyecto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Fotos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnSettingsClick" ToolTip="Carpeta de proyectos y archivos base">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rutas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}"
                        Visibility="{Binding HasEnvironmentWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EnvironmentWarning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <!-- 1. Orden de trabajo -->
                <Border Style="{StaticResource Card}" AllowDrop="True" DragOver="OnPdfDragOver" Drop="OnPdfDrop">
                    <StackPanel>
                        <TextBlock Text="Orden de trabajo" Style="{StaticResource CardTitle}"/>
                        <Button Style="{StaticResource DropZone}" Click="OnPickPdfClick">
                            <StackPanel>
                                <TextBlock Text="{Binding PdfTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                <TextBlock Text="{Binding PdfHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding PdfWarning}" Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasPdfWarning, Converter={StaticResource BoolToVis}}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="N.º de orden" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Orden, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="ID del proyecto" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding IdProyecto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                <TextBlock Text="Proyecto" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Proyecto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Localidad" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Localidad, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Responsables -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Responsables" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Interventor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Interventores}" SelectedItem="{Binding Interventor}"/>
                        <TextBlock Text="{Binding InterventorBadge}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Ok}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InterventorBadgeIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding NeedsManualInterventor, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nombre completo con código (ej. NOMBRE APELLIDO (12345))" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ManualInterventor, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Text="Supervisor" Style="{StaticResource FieldLabel}" Margin="2,12,0,3"/>
                        <ComboBox ItemsSource="{Binding Supervisores}" SelectedItem="{Binding Supervisor}"/>
                    </StackPanel>
                </Border>

                <!-- 3. Fechas -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Fechas" Style="{StaticResource CardTitle}" Margin="0,0,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,2"
                                   Text="Escribe 2509 (25 de este mes) o 250926, o elige en el calendario. Las demás siguen a la anterior hasta que las cambies."/>
                        <ItemsControl ItemsSource="{Binding DateRows}" Focusable="False"/>
                    </StackPanel>
                </Border>

                <!-- 4. Plano y opciones -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Plano y opciones" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Diámetro" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Diametro" Content="3/4&quot;" Style="{StaticResource Segment}" IsChecked="{Binding Is34}"/>
                                    <RadioButton GroupName="Diametro" Content="1/2&quot;" Style="{StaticResource Segment}" IsChecked="{Binding Is12}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tubería" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Tuberia" Content="EXTRUCOL" Style="{StaticResource Segment}" IsChecked="{Binding IsExtrucol}"/>
                                    <RadioButton GroupName="Tuberia" Content="PAVCO" Style="{StaticResource Segment}" IsChecked="{Binding IsPavco}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Incluir el Libro de Cantidades" Margin="0,14,0,0" IsChecked="{Binding IncludeLibro}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
